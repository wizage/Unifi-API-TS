{
  "entryPoints": [
    "src/index.ts"
  ],
  "exclude": [
    "src/generated/api-methods.ts"
  ],
  "entryPointStrategy": "resolve",
  "out": "docs/api",
  "name": "UniFi API TypeScript Client",
  "readme": "README.md",
  "theme": "default",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeProtected": false,
  "excludeExternals": true,
  "categorizeByGroup": true,
  "defaultCategory": "Other",
  "categoryOrder": [
    "Client",
    "API",
    "Authentication",
    "Device Management",
    "Client Management", 
    "Network Management",
    "Site Management",
    "Site Configuration",
    "Site LED Control",
    "Site Statistics",
    "User Management",
    "Administrator Management",
    "Security",
    "Statistics & Monitoring",
    "Guest Management",
    "HTTP",
    "Session Management",
    "Types",
    "Errors",
    "Generated API Methods",
    "*"
  ],
  "sort": [
    "source-order"
  ],
  "kindSortOrder": [
    "Class",
    "Constructor",
    "Property",
    "Method",
    "Function",
    "Interface",
    "TypeAlias",
    "Variable",
    "Enum"
  ],
  "searchInComments": true,
  "cleanOutputDir": true,
  "titleLink": "https://github.com/wizage/Unifi-API-TS",
  "navigationLinks": {
    "GitHub": "https://github.com/wizage/Unifi-API-TS",
    "NPM": "https://www.npmjs.com/package/unifi-api-ts"
  },
  "gitRevision": "main",
  "gitRemote": "origin",
  "sourceLinkTemplate": "https://github.com/wizage/Unifi-API-TS/blob/{gitRevision}/{path}#L{line}",
  "groupOrder": [
    "Classes",
    "Interfaces", 
    "Type Aliases",
    "Functions",
    "Variables"
  ],
  "visibilityFilters": {
    "protected": false,
    "private": false,
    "inherited": true,
    "external": false
  },
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "notDocumented": false
  },
  "treatWarningsAsErrors": false,
  "intentionallyNotExported": [
    "RequestConfig",
    "HTTPClientConfig"
  ]
}